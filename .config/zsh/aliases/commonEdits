# shell editing
alias confzsh="y ${ZDOTDIR}"
alias confzshrc="sudo nvim ${ZDOTDIR}/.zshrc"
alias confzshenv="sudo nvim ${ZDOTDIR}/.zshenv"
alias srczsh="source ${ZDOTDIR}/.zshrc" #source zsh again after configuring
alias srctmux="tmux source ~/.config/tmux/tmux.conf" #source tmux again when still within tmux

